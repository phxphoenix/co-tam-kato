# Hasło / sekret administratora dla panelu /admin/* oraz API (/api/sources, /api/archive-settings, /api/archive-run)
ADMIN_SECRET="zmien-na-silne-haslo-administratora"

# Token GitHub (Personal Access Token / Fine-grained PAT z uprawnieniem Contents: Read and write)
# Wymagany na Vercelu, aby zapisy w config/sources.md oraz archive.json po zalogowaniu ADMIN_SECRET tworzyły commity na main
GITHUB_TOKEN=""

# Klucz Google Gemini API używany przez skrypt scripts/daily-digest.mjs
GEMINI_API_KEY=""

# Opcjonalne zmienne OAuth Keystatic CMS na Vercelu
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
KEYSTATIC_SECRET=""
