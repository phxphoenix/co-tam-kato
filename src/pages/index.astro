---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveFeed } from '../components/InteractiveFeed';
import { getCollection } from 'astro:content';
import { Sparkles, Clock, MapPin, Compass } from 'lucide-react';

// Pobranie wszystkich wpisów z kolekcji
const allNews = (await getCollection('news')).filter((item) => item.data.status !== 'deleted');

// Sortowanie od najnowszej publikacji źródłowej; wpisy bez niej używają daty dodania
const sortedNews = allNews.sort(
  (a, b) => (b.data.sourceDate ?? b.data.pubDate).getTime() - (a.data.sourceDate ?? a.data.pubDate).getTime()
);

// Filtrowanie alertów do paska na samej górze
const activeAlerts = sortedNews
  .filter((item) => item.data.isAlert && item.data.status === 'published')
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    summary: item.data.summary,
    city: item.data.city,
    slug: item.id.replace(/\.(md|mdx)$/, ''),
  }));

// Przygotowanie danych w formacie przekazywalnym do komponentu React
const serializedItems = sortedNews.map((item) => ({
  id: item.id,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  title: item.data.title,
  pubDate: item.data.pubDate.toISOString(),
  sourceDate: (item.data.sourceDate ?? item.data.pubDate).toISOString(),
  city: item.data.city,
  category: item.data.category,
  status: item.data.status,
  summary: item.data.summary,
  location: item.data.location,
  isAlert: item.data.isAlert,
  sourceUrl: item.data.sourceUrl,
  aiGenerated: item.data.aiGenerated,
}));
---

<BaseLayout alerts={activeAlerts}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-14 border-b border-zinc-900 bg-gradient-to-b from-zinc-900/60 via-zinc-950 to-zinc-950">
    <!-- Subtelne tło ze świetlistym gradientem -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-5">
          <Sparkles className="w-3.5 h-3.5" />
          <span>Poranny lokalny digest • Katowice & Miasta Ościenne</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 tracking-tight leading-tight mb-5">
          Co dzieje się dzisiaj <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">
            za Twoim oknem?
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed mb-8">
          Koncerty, imprezy w Parku Śląskim, nocne remonty na DTŚ, nowe rzemieślnicze piekarnie i wydarzenia kulturalne. Wszystko w jednym miejscu, bez clickbaitu i natłoku reklam.
        </p>

        <!-- Szybkie wskaźniki -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs text-zinc-400">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <Clock className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Aktualizacja codziennie o 6:00</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <MapPin className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Katowice + 10 miast ościennych</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60 col-span-2 sm:col-span-1">
            <Compass className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Filtrowanie na żywo w ułamku sekundy</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feed Section z interaktywnym filtrowaniem React -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <InteractiveFeed client:load initialItems={serializedItems} />
  </section>
</BaseLayout>
