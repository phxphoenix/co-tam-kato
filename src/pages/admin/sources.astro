---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourcesAdminDashboard from '../../components/admin/SourcesAdminDashboard';
import { getAllSources, getPaginationSettings } from '../../server/sources-service';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// Pobranie bieżących źródeł oraz ustawień paginacji z config/sources.md
const initialSources = getAllSources();
const initialPaginationSettings = getPaginationSettings();
---

<BaseLayout
  title="Baza Źródeł Wydarzeń | Admin | Co Tam KATO"
  description="Przeglądanie i zarządzanie źródłami wydarzeń bezpośrednio w pliku config/sources.md dla Agenta AI."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <SourcesAdminDashboard
      client:load
      initialSources={initialSources}
      initialPaginationSettings={initialPaginationSettings}
      baseUrl={base}
    />
  </main>
</BaseLayout>
