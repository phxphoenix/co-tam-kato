---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveFeed } from '../components/InteractiveFeed';
import { getCollection } from 'astro:content';
import { Smile, Sparkles, MapPin, Heart, Compass, Star } from 'lucide-react';

const allNews = await getCollection('news');

// Sortowanie od najnowszych
const sortedNews = allNews.sort(
  (a, b) => (b.data.sourceDate ?? b.data.pubDate).getTime() - (a.data.sourceDate ?? a.data.pubDate).getTime()
);

const serializedItems = sortedNews.map((item) => ({
  id: item.id,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  title: item.data.title,
  pubDate: item.data.pubDate.toISOString(),
  sourceDate: (item.data.sourceDate ?? item.data.pubDate).toISOString(),
  city: item.data.city,
  category: item.data.category,
  status: item.data.status,
  summary: item.data.summary,
  location: item.data.location,
  isAlert: item.data.isAlert,
  isForKids: item.data.isForKids || item.data.category === 'dla-dzieci',
  ageRange: item.data.ageRange,
  sourceUrl: item.data.sourceUrl,
  aiGenerated: item.data.aiGenerated,
}));
---

<BaseLayout
  title="Dla Dzieci (4-10 lat) w Katowicach i okolicy | KATO Dzieciaki"
  description="Wydarzenia, warsztaty, teatrzyki i weekendowe atrakcje dla dzieci w wieku od 4 do 10 lat w Katowicach, Chorzowie i całej aglomeracji."
>
  <!-- Hero Section Dziecięcy -->
  <section class="relative overflow-hidden pt-12 pb-14 border-b border-zinc-900 bg-gradient-to-b from-emerald-950/40 via-zinc-950 to-zinc-950">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold uppercase tracking-wider mb-5">
          <Smile className="w-3.5 h-3.5" />
          <span>Strefa Rodzica i Malucha • Wiek 4 – 10 lat</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 tracking-tight leading-tight mb-5">
          Co robić z dzieckiem <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300">
            w ten weekend w Kato i okolicy?
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed mb-8">
          Wyselekcjonowane warsztaty plastyczne i naukowe, spektakle lalkowe, kosmiczne pokazy i aktywne spacery dopasowane specjalnie do możliwości oraz zainteresowań dzieci w wieku przedszkolnym i wczesnoszkolnym (4–10 lat).
        </p>

        <!-- Polecane stałe miejscówki dla dzieci w aglomeracji -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs text-zinc-300">
          <div class="p-3 rounded-2xl bg-zinc-900/80 border border-zinc-800">
            <strong class="text-emerald-400 block font-bold mb-1 flex items-center gap-1.5">
              <Star className="w-3.5 h-3.5" /> Bajka Pana Kleksa
            </strong>
            <span>Fabryka Porcelany Katowice • Interaktywne centrum nauki i zabawy.</span>
          </div>
          <div class="p-3 rounded-2xl bg-zinc-900/80 border border-zinc-800">
            <strong class="text-teal-400 block font-bold mb-1 flex items-center gap-1.5">
              <Star className="w-3.5 h-3.5" /> Planetarium Śląskie
            </strong>
            <span>Park Śląski • Dedykowane seanse 3D i symulator trzęsienia ziemi.</span>
          </div>
          <div class="p-3 rounded-2xl bg-zinc-900/80 border border-zinc-800">
            <strong class="text-amber-400 block font-bold mb-1 flex items-center gap-1.5">
              <Star className="w-3.5 h-3.5" /> Teatr Lalek Ateneum
            </strong>
            <span>Katowice Centrum • Magiczne spektakle z warsztatami plastycznymi.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feed Section dla Dzieci -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <InteractiveFeed client:load initialItems={serializedItems} defaultOnlyKids={true} defaultCategory="dla-dzieci" />
  </section>
</BaseLayout>
