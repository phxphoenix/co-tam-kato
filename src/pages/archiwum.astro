---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveFeed } from '../components/InteractiveFeed';
import { getCollection } from 'astro:content';
import { getPaginationSettings } from '../server/sources-service';
import { Archive, FolderClock, History, Layers } from 'lucide-react';

// Odczyt domyślnego rozmiaru strony archiwum z config/sources.md
const { archivePageSize } = getPaginationSettings();

// Pobranie wpisów z kolekcji (status !== 'deleted', uwzględniając stan item.data.archived w InteractiveFeed)
const allNews = (await getCollection('news')).filter(
  (item) => item.data.status !== 'deleted'
);

// Domyślne sortowanie od najnowszych według daty publikacji
const sortedNews = allNews.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

// Serializacja artykułów do komponentu React
const serializedItems = sortedNews.map((item) => ({
  id: item.id,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  title: item.data.title,
  publishedDate: item.data.publishedDate.toISOString(),
  eventDate: item.data.eventDate ? item.data.eventDate.toISOString() : null,
  city: item.data.city,
  category: item.data.category,
  status: item.data.status,
  summary: item.data.summary,
  location: item.data.location,
  isAlert: item.data.isAlert,
  archived: Boolean(item.data.archived),
  manualOverride: Boolean(item.data.manualOverride),
  isForKids: item.data.isForKids || item.data.category === 'dla-dzieci',
  ageRange: item.data.ageRange,
  sourceUrl: item.data.sourceUrl,
  aiGenerated: item.data.aiGenerated,
}));
---

<BaseLayout
  title="Archiwum Wiadomości i Wydarzeń | Co Tam KATO"
  description="Przeglądaj starsze oraz manualnie zarchiwizowane artykuły, relacje z minionych wydarzeń i komunikaty z Katowic oraz miast ościennych."
>
  <!-- Hero Section Sekcji Archiwum -->
  <section class="relative overflow-hidden pt-12 pb-14 border-b border-zinc-900 bg-gradient-to-b from-amber-950/25 via-zinc-950 to-zinc-950">
    <!-- Subtelne tło ze świetlistym gradientem -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-5">
          <Archive className="w-3.5 h-3.5 text-amber-400" />
          <span>Archiwum Wpisów • Historia i minione wydarzenia</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 tracking-tight leading-tight mb-5">
          Archiwum <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">
            Wiadomości i Wydarzeń
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed mb-8">
          Przeglądaj starsze artykuły, archiwalne relacje i zakończone wydarzenia z całej aglomeracji śląskiej. Wygodne wyszukiwanie po słowach kluczowych, miastach, kategoriach i datach publikacji.
        </p>

        <!-- Szybkie wskaźniki korzyści -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs text-zinc-400">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <FolderClock className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Pełna historia artykułów</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <History className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Domyślnie od najnowszych</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <Layers className="w-4 h-4 text-amber-400 flex-shrink-0" />
            <span>Wsparcie dla ulubionych</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feed Section dla Archiwum z identycznym układem, siatką i paginacją -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <InteractiveFeed
      client:load
      initialItems={serializedItems}
      isArchiveView={true}
      archivePageSize={archivePageSize}
    />
  </section>
</BaseLayout>
