---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveFeed } from '../components/InteractiveFeed';
import { getCollection } from 'astro:content';
import { Heart, Sparkles, Calendar, BookmarkCheck } from 'lucide-react';

const allNews = (await getCollection('news')).filter((item) => item.data.status !== 'deleted');

// Sortowanie od najnowszej daty publikacji
const sortedNews = allNews.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const serializedItems = sortedNews.map((item) => ({
  id: item.id,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  title: item.data.title,
  publishedDate: item.data.publishedDate.toISOString(),
  eventDate: item.data.eventDate ? item.data.eventDate.toISOString() : null,
  city: item.data.city,
  category: item.data.category,
  status: item.data.status,
  summary: item.data.summary,
  location: item.data.location,
  isAlert: item.data.isAlert,
  archived: Boolean(item.data.archived),
  manualOverride: Boolean(item.data.manualOverride),
  isForKids: item.data.isForKids || item.data.category === 'dla-dzieci',
  ageRange: item.data.ageRange,
  sourceUrl: item.data.sourceUrl,
  aiGenerated: item.data.aiGenerated,
}));
---

<BaseLayout
  title="Ulubione Artykuły i Wydarzenia | Co Tam KATO"
  description="Twoje zapisane wiadomości, polecane miejscówki i nadchodzące wydarzenia z Katowic i miast ościennych."
>
  <!-- Hero Section Sekcji Ulubionych -->
  <section class="relative overflow-hidden pt-12 pb-14 border-b border-zinc-900 bg-gradient-to-b from-rose-950/30 via-zinc-950 to-zinc-950">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-rose-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold uppercase tracking-wider mb-5">
          <Heart className="w-3.5 h-3.5 fill-current text-rose-400" />
          <span>Twoja Prywatna Kolekcja • Zapisane na tym urządzeniu</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 tracking-tight leading-tight mb-5">
          Twoje Ulubione <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-pink-300 to-amber-300">
            Wiadomości i Wydarzenia
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed mb-8">
          Wszystkie artykuły i inspiracje, które oznaczyłeś serduszkiem (❤️). Możesz je swobodnie filtrować według daty publikacji źródła, miast aglomeracji, kategorii lub wyszukiwać po słowach kluczowych.
        </p>

        <!-- Szybkie wskaźniki korzyści -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs text-zinc-400">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <BookmarkCheck className="w-4 h-4 text-rose-400 flex-shrink-0" />
            <span>Pamięć lokalna w przeglądarce</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <Calendar className="w-4 h-4 text-rose-400 flex-shrink-0" />
            <span>Filtrowanie datami działa tak samo</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60">
            <Sparkles className="w-4 h-4 text-rose-400 flex-shrink-0" />
            <span>Szybki dostęp jednym kliknięciem</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feed Section ze stanem domyślnie tylko ulubionych -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <InteractiveFeed client:load initialItems={serializedItems} defaultOnlyFavorites={true} />
  </section>
</BaseLayout>
