---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourcesAdminDashboard from '../components/admin/SourcesAdminDashboard';
import { getAllSources, getBalanceSettings, getPaginationSettings } from '../server/sources-service';
import { isAdminAuthenticated } from '../server/admin-auth';

export const prerender = false;

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const authenticated = await isAdminAuthenticated(Astro.request);
if (!authenticated) {
  return Astro.redirect(
    `${base}admin/login?next=${encodeURIComponent(`${base}admin/sources`)}`,
    302
  );
}

// Pobranie bieżących źródeł oraz ustawień paginacji i Workera AI z config/sources.md
const initialSources = getAllSources();
const initialPaginationSettings = getPaginationSettings();
const initialBalanceSettings = getBalanceSettings();
---

<BaseLayout
  title="Baza Źródeł Wydarzeń | Admin | Co Tam KATO"
  description="Przeglądanie i zarządzanie źródłami wydarzeń bezpośrednio w pliku config/sources.md dla Agenta AI."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <SourcesAdminDashboard
      client:load
      initialSources={initialSources}
      initialPaginationSettings={initialPaginationSettings}
      initialBalanceSettings={initialBalanceSettings}
      baseUrl={base}
    />
  </main>
</BaseLayout>
