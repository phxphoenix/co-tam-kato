---
import { Heart, Cpu } from 'lucide-react';

const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-zinc-800/80 bg-zinc-950 text-zinc-400 mt-20 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- O projekcie -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-lg font-black tracking-tight text-zinc-100">
            Co Tam <span class="text-amber-400">KATO</span>
          </span>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-md">
          Twój codzienny, lokalny digest informacyjny. Wszystko, co ważne w Katowicach, Chorzowie, Siemianowicach, Sosnowcu, Mysłowicach i całej aglomeracji śląskiej w jednym, przejrzystym miejscu.
        </p>
        <div class="flex items-center gap-2 text-xs text-zinc-500 pt-2">
          <Cpu className="w-3.5 h-3.5 text-amber-400" />
          <span>Napędzane przez Astro 5, React, Tailwind CSS i automatyzację GitHub Actions.</span>
        </div>
      </div>

      <!-- Miasta w zasięgu -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-200 mb-3">
          Zasięg serwisu
        </h4>
        <ul class="text-xs space-y-1.5 text-zinc-400">
          <li>Katowice (Centrum, Ligota, Koszutka)</li>
          <li>Chorzów & Park Śląski</li>
          <li>Siemianowice Śląskie</li>
          <li>Sosnowiec & Zagłębie</li>
          <li>Mysłowice, Ruda Śląska, Tychy</li>
          <li>Czeladź, Bytom, Świętochłowice</li>
        </ul>
      </div>

      <!-- Szybkie linki -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-200 mb-3">
          Nawigacja
        </h4>
        <ul class="text-xs space-y-2">
          <li>
            <a href={base} class="hover:text-amber-400 transition-colors">Wszystkie wiadomości</a>
          </li>
          <li>
            <a href={`${base}dla-dzieci`} class="hover:text-amber-400 transition-colors">Dla Dzieci (4-10 lat)</a>
          </li>
          <li>
            <a href={`${base}o-projekcie`} class="hover:text-amber-400 transition-colors">O projekcie i misji</a>
          </li>
          <li>
            <a href={`${base}keystatic`} class="hover:text-amber-400 transition-colors inline-flex items-center gap-1 text-amber-400/90">
              Panel administracyjny Keystatic →
            </a>
          </li>
          <li>
            <a
              href="https://github.com/phxphoenix/co-tam-kato"
              target="_blank"
              rel="noreferrer"
              class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5 pt-1"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>Kod na GitHubie</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Prawa autorskie -->
    <div class="border-t border-zinc-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <p>© {new Date().getFullYear()} Co Tam KATO. Projekt lokalny aglomeracji górnośląskiej.</p>
      <p class="flex items-center gap-1">
        Stworzone z <Heart className="w-3.5 h-3.5 text-rose-500 fill-rose-500" /> dla Katowic i okolic
      </p>
    </div>
  </div>
</footer>
