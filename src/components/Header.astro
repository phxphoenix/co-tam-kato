---
import { Calendar, MapPin, Settings, Smile } from 'lucide-react';

const today = new Intl.DateTimeFormat('pl-PL', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

const capitalizedDate = today.charAt(0).toUpperCase() + today.slice(1);
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
    <!-- Logo & Nazwa -->
    <a href={base} class="group flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-300 flex items-center justify-center text-zinc-950 font-black text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
        K
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-zinc-100 group-hover:text-amber-400 transition-colors">
            Co Tam <span class="text-amber-400">KATO</span>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-wider bg-zinc-800 text-amber-300/90 px-2 py-0.5 rounded-full border border-zinc-700 hidden sm:inline-block">
            Metropolia
          </span>
        </div>
        <p class="text-xs text-zinc-400 flex items-center gap-1">
          <MapPin className="w-3 h-3 text-amber-400" />
          Katowice & sąsiedzi
        </p>
      </div>
    </a>

    <!-- Data i Nawigacja -->
    <div class="flex items-center gap-3 sm:gap-6">
      <div class="hidden lg:flex items-center gap-1.5 text-xs text-zinc-400 bg-zinc-900/80 px-3 py-1.5 rounded-full border border-zinc-800">
        <Calendar className="w-3.5 h-3.5 text-amber-400" />
        <span>{capitalizedDate}</span>
      </div>

      <nav class="flex items-center gap-1.5 sm:gap-2 text-xs font-semibold">
        <a
          href={base}
          class="px-2.5 sm:px-3 py-1.5 rounded-lg text-zinc-300 hover:text-white hover:bg-zinc-800/60 transition-colors"
        >
          Wiadomości
        </a>
        <a
          href={`${base}dla-dzieci`}
          class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 rounded-lg text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 transition-colors"
        >
          <Smile className="w-3.5 h-3.5" />
          <span>Dla Dzieci (4-10)</span>
        </a>
        <a
          href={`${base}o-projekcie`}
          class="px-2.5 sm:px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-colors hidden sm:inline-block"
        >
          O serwisie
        </a>
        <a
          href={`${base}keystatic`}
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-amber-400 text-amber-400 hover:text-zinc-950 border border-amber-500/30 transition-all shadow-sm"
          title="Panel administracyjny Keystatic CMS"
        >
          <Settings className="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Panel Admina</span>
        </a>
      </nav>
    </div>
  </div>
</header>
