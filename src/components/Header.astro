---
import { Calendar, MapPin, Settings, Heart, Menu, X } from 'lucide-react';

export interface Props {
  currentPath?: string;
  base?: string;
  showAdmin?: boolean;
  adminHref?: string;
  showDate?: boolean;
  date?: string;
}

const rawBase = Astro.props.base || import.meta.env.BASE_URL || '/';
const normalizedBase = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const {
  showAdmin = true,
  adminHref = `${normalizedBase}keystatic`,
  showDate = true,
  date,
} = Astro.props;

const currentPath = Astro.props.currentPath || Astro.url.pathname;

function isPathActive(linkPath: string): boolean {
  const fullHref = `${normalizedBase}${linkPath}`.replace(/\/+$/, '');
  const cleanCurrent = (currentPath || '').replace(/\/+$/, '');

  if (linkPath === '') {
    const baseClean = normalizedBase.replace(/\/+$/, '');
    return cleanCurrent === baseClean || cleanCurrent === '';
  }
  return cleanCurrent === fullHref || cleanCurrent.startsWith(`${fullHref}/`);
}

function getShortFormattedDate(d: Date = new Date()): string {
  const formatted = new Intl.DateTimeFormat('pl-PL', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  }).format(d);
  const clean = formatted.replace('.', '');
  return clean.charAt(0).toUpperCase() + clean.slice(1);
}

function getLongFormattedDate(d: Date = new Date()): string {
  const formatted = new Intl.DateTimeFormat('pl-PL', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(d);
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
}

const compactDate = date || getShortFormattedDate();
const fullDate = date || getLongFormattedDate();

const isFavoritesActive = isPathActive('ulubione');
const isAdminActive = isPathActive('keystatic') || isPathActive('admin');
const hasAdminCookie = Boolean(Astro.cookies?.get('keystatic-gh-access-token')?.value);
---

<header class="border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Logo & Nazwa -->
    <a href={normalizedBase} class="group flex items-center gap-2.5 sm:gap-3 shrink-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-300 flex items-center justify-center text-zinc-950 font-black text-lg sm:text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform shrink-0">
        K
      </div>
      <div class="shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-lg sm:text-xl font-black tracking-tight text-zinc-100 group-hover:text-amber-400 transition-colors whitespace-nowrap">
            Co Tam <span class="text-amber-400">KATO</span>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-wider bg-zinc-800 text-amber-300/90 px-2 py-0.5 rounded-full border border-zinc-700 hidden sm:inline-block whitespace-nowrap">
            Metropolia
          </span>
        </div>
        <p class="text-xs text-zinc-400 flex items-center gap-1 whitespace-nowrap">
          <MapPin className="w-3 h-3 text-amber-400 shrink-0" />
          <span>Katowice & sąsiedzi</span>
        </p>
      </div>
    </a>

    <!-- Widok Desktop (hidden lg:flex): Główna nawigacja + sekcja narzędziowa -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-5">
      <!-- Główna nawigacja -->
      <nav class="flex items-center gap-1" aria-label="Główna nawigacja">
        <a
          href={normalizedBase}
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center gap-1.5 ${
            isPathActive('')
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
          }`}
        >
          {isPathActive('') && (
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
          )}
          <span>Wiadomości</span>
        </a>

        <a
          href={`${normalizedBase}dla-dzieci`}
          title="Strefa dla dzieci w wieku 4-10 lat"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center gap-1.5 ${
            isPathActive('dla-dzieci')
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
          }`}
        >
          {isPathActive('dla-dzieci') && (
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
          )}
          <span>Dla dzieci</span>
        </a>

        <a
          href={`${normalizedBase}archiwum`}
          title="Archiwum artykułów"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center gap-1.5 ${
            isPathActive('archiwum')
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
          }`}
        >
          {isPathActive('archiwum') && (
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
          )}
          <span>Archiwum</span>
        </a>

        <a
          href={`${normalizedBase}o-projekcie`}
          title="O serwisie Co Tam KATO"
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center gap-1.5 ${
            isPathActive('o-projekcie')
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
          }`}
        >
          {isPathActive('o-projekcie') && (
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
          )}
          <span>O serwisie</span>
        </a>
      </nav>

      <!-- Sekcja narzędziowa na końcu paska -->
      <div class="flex items-center gap-2">
        <!-- Kompaktowa data (widoczna tylko na dużych ekranach xl+) -->
        {showDate && (
          <div class="hidden xl:flex items-center gap-1.5 text-xs text-zinc-400 bg-zinc-900/80 border border-zinc-800 px-2.5 py-1.5 rounded-full whitespace-nowrap">
            <Calendar className="w-3.5 h-3.5 text-amber-400 shrink-0" />
            <span>{compactDate}</span>
          </div>
        )}

        <!-- Ulubione zintegrowane w stylu paska -->
        <a
          href={`${normalizedBase}ulubione`}
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center gap-1.5 ${
            isFavoritesActive
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-rose-400 hover:bg-zinc-800/60'
          }`}
          title="Twoje ulubione artykuły"
        >
          <Heart className={`w-4 h-4 shrink-0 ${isFavoritesActive ? 'fill-current' : ''}`} />
          <span>Ulubione</span>
          <span
            data-favorites-count
            class="hidden text-[11px] font-semibold px-1.5 py-0.2 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30"
          ></span>
        </a>

        <!-- Dyskretny Panel Admina (zębatka po separatorze) -->
        {showAdmin && (
          <div class="flex items-center border-l border-zinc-800 pl-3 ml-1">
            <a
              href={adminHref}
              class={`relative text-zinc-400 hover:text-amber-400 p-2 rounded-lg hover:bg-zinc-800/60 transition-colors ${
                isAdminActive ? 'text-amber-400 bg-zinc-800/80' : ''
              }`}
              title={hasAdminCookie ? 'Panel administracyjny (zalogowano)' : 'Panel administracyjny'}
              aria-label="Panel administracyjny"
            >
              <Settings className="w-4 h-4 shrink-0" />
              {hasAdminCookie && (
                <span
                  class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-amber-400 ring-2 ring-zinc-950"
                  title="Zalogowano jako administrator"
                />
              )}
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- Widok Mobile: Szybki skrót do Ulubionych + Przycisk Hamburgera -->
    <div class="flex lg:hidden items-center gap-1 sm:gap-2 shrink-0">
      <a
        href={`${normalizedBase}ulubione`}
        class="relative p-2 rounded-lg text-zinc-400 hover:text-rose-400 hover:bg-zinc-800/60 transition-colors"
        title="Twoje ulubione artykuły"
        aria-label="Ulubione artykuły"
      >
        <Heart className={`w-5 h-5 shrink-0 ${isFavoritesActive ? 'fill-rose-400 text-rose-400' : ''}`} />
        <span
          data-favorites-count
          class="hidden absolute -top-0.5 -right-0.5 min-w-[16px] h-4 px-1 flex items-center justify-center text-[10px] font-bold rounded-full bg-rose-500 text-white"
        ></span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500/50"
        aria-label="Otwórz menu nawigacji"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu className="w-6 h-6 block" id="menu-icon-open" />
        <X className="w-6 h-6 hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Rozwijany / wysuwany panel mobilny -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-zinc-800/80 bg-zinc-950/95 backdrop-blur-xl px-4 py-4 transition-all duration-200"
  >
    <div class="flex flex-col gap-1 text-sm font-medium">
      <a
        href={normalizedBase}
        class={`py-3 px-4 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center justify-between ${
          isPathActive('')
            ? 'text-amber-400 bg-zinc-800/80'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
        }`}
      >
        <span>Wiadomości</span>
        {isPathActive('') && (
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
        )}
      </a>

      <a
        href={`${normalizedBase}dla-dzieci`}
        title="Strefa dla dzieci w wieku 4-10 lat"
        class={`py-3 px-4 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center justify-between ${
          isPathActive('dla-dzieci')
            ? 'text-amber-400 bg-zinc-800/80'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
        }`}
      >
        <span>Dla dzieci</span>
        {isPathActive('dla-dzieci') && (
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
        )}
      </a>

      <a
        href={`${normalizedBase}archiwum`}
        title="Archiwum artykułów"
        class={`py-3 px-4 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center justify-between ${
          isPathActive('archiwum')
            ? 'text-amber-400 bg-zinc-800/80'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
        }`}
      >
        <span>Archiwum</span>
        {isPathActive('archiwum') && (
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
        )}
      </a>

      <a
        href={`${normalizedBase}o-projekcie`}
        title="O serwisie Co Tam KATO"
        class={`py-3 px-4 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center justify-between ${
          isPathActive('o-projekcie')
            ? 'text-amber-400 bg-zinc-800/80'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'
        }`}
      >
        <span>O serwisie</span>
        {isPathActive('o-projekcie') && (
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0" aria-hidden="true" />
        )}
      </a>
    </div>

    {/* Pełna data */}
    {showDate && (
      <div class="mt-4 pt-3 border-t border-zinc-800/60 flex items-center gap-2 text-xs text-zinc-400 px-3 py-2.5 bg-zinc-900/60 rounded-lg">
        <Calendar className="w-4 h-4 text-amber-400 shrink-0" />
        <span>{fullDate}</span>
      </div>
    )}

    {/* Na samym dole, oddzielony linią border-t border-zinc-800 pt-3 mt-2, czytelny link z ikoną zębatki do „Panelu Admina” */}
    {showAdmin && (
      <div class="border-t border-zinc-800 pt-3 mt-2">
        <a
          href={adminHref}
          class={`py-3 px-4 rounded-lg text-sm font-medium transition-colors whitespace-nowrap flex items-center justify-between ${
            isAdminActive
              ? 'text-amber-400 bg-zinc-800/80'
              : 'text-zinc-400 hover:text-amber-400 hover:bg-zinc-800/60'
          }`}
          title="Panel administracyjny"
        >
          <span class="flex items-center gap-2.5">
            <Settings className="w-4 h-4 text-amber-400 shrink-0" />
            <span>Panel Admina</span>
          </span>
          {hasAdminCookie && (
            <span class="text-[10px] uppercase font-bold text-amber-400/90 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-full">
              Zalogowano
            </span>
          )}
        </a>
      </div>
    )}
  </div>
</header>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    function setMenuOpen(open: boolean) {
      if (!mobileMenu || !toggleBtn) return;
      if (open) {
        mobileMenu.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        toggleBtn.setAttribute('aria-label', 'Zamknij menu nawigacji');
        iconOpen?.classList.add('hidden');
        iconOpen?.classList.remove('block');
        iconClose?.classList.remove('hidden');
        iconClose?.classList.add('block');
      } else {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.setAttribute('aria-label', 'Otwórz menu nawigacji');
        iconOpen?.classList.remove('hidden');
        iconOpen?.classList.add('block');
        iconClose?.classList.add('hidden');
        iconClose?.classList.remove('block');
      }
    }

    if (toggleBtn && !toggleBtn.dataset.listenerAttached) {
      toggleBtn.dataset.listenerAttached = 'true';
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isExpanded);
      });
    }

    // Zamykanie menu po kliknięciu w dowolny link wewnątrz menu mobilnego
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
      });
    });

    // Zamykanie menu po kliknięciu poza obszarem menu
    document.addEventListener('click', (e) => {
      if (!mobileMenu || !toggleBtn) return;
      const target = e.target as Node;
      if (
        !mobileMenu.classList.contains('hidden') &&
        !mobileMenu.contains(target) &&
        !toggleBtn.contains(target)
      ) {
        setMenuOpen(false);
      }
    });

    // Zamykanie klawiszem Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setMenuOpen(false);
      }
    });

    // Zamykanie przy powrocie do widoku desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        setMenuOpen(false);
      }
    });

    // Synchronizacja licznika ulubionych artykułów
    function updateFavoritesCount() {
      try {
        const raw = localStorage.getItem('kato_favorite_articles_v1');
        const favs = raw ? JSON.parse(raw) : [];
        const count = Array.isArray(favs) ? favs.length : 0;
        document.querySelectorAll('[data-favorites-count]').forEach((el) => {
          if (count > 0) {
            el.textContent = String(count);
            el.classList.remove('hidden');
          } else {
            el.textContent = '';
            el.classList.add('hidden');
          }
        });
      } catch {
        // ignore
      }
    }

    updateFavoritesCount();
    window.addEventListener('kato_favorites_changed', updateFavoritesCount);
    window.addEventListener('storage', updateFavoritesCount);
  }

  // Inicjalizacja skryptu nawigacji
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>
