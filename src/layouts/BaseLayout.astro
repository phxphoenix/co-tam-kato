---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { QuickAlertBar } from '../components/QuickAlertBar';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  alerts?: Array<{
    id: string;
    title: string;
    summary: string;
    city: string;
    slug: string;
  }>;
}

const {
  title = 'Co Tam KATO | Codzienne wydarzenia i aktualności Katowice i okolica',
  description = 'Najświeższe informacje z Katowic, Chorzowa, Sosnowca, Siemianowic i miast ościennych. Wydarzenia, koncerty, utrudnienia drogowe, alerty i kulinaria.',
  alerts = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-zinc-100 flex flex-col min-h-screen">
    {alerts && alerts.length > 0 && (
      <QuickAlertBar client:load alerts={alerts} />
    )}

    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
